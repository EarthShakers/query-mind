# 阿里云百炼 API Key (https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=sk-your-api-key-here

# Upstash Redis (https://upstash.com) — 用于限流和 token 用量统计
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Supabase (https://supabase.com) — 向量数据库，用于 RAG 知识库
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx

# Supabase PostgreSQL 直连（Settings > Database > Connection string）
# 用于 Excel 数据表的动态建表和查询
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
